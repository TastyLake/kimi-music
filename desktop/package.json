{
  "name": "loral",
  "productName": "Loral",
  "version": "1.1.1",
  "private": true,
  "description": "Loral — окно Windows для локальной медиатеки",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "node fetch-vendor.cjs && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.loral.desktop",
    "productName": "Loral",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "loral/backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!dist/**",
          "!media/**",
          "!data/**",
          "!.env"
        ]
      },
      {
        "from": "../frontend",
        "to": "loral/frontend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.next/**",
          "!.env.local"
        ]
      },
      {
        "from": "../docker-compose.yml",
        "to": "loral/docker-compose.yml"
      },
      {
        "from": "vendor",
        "to": "loral/vendor",
        "filter": ["**/*", "!cache/**"]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "executableName": "Loral"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loral",
      "uninstallDisplayName": "Loral",
      "artifactName": "Loral-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}

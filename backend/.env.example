# --- Сервер ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Хранилища ---
DATABASE_URL=postgresql://music:music@localhost:5432/music?schema=public
REDIS_URL=redis://localhost:6379
# Корневая папка с музыкой (сюда же сохраняются веб-загрузки)
MUSIC_DIR=./media/music
# Служебные данные: обложки, временные файлы загрузки
DATA_DIR=./data

# --- Авторизация (замените на длинные случайные строки!) ---
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
ALLOW_REGISTRATION=true
# Администратор создаётся при старте, если в базе ещё нет ни одного ADMIN
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Внешние API ---
# Last.fm: https://www.last.fm/api/account/create (нужен для жанровых подборок и тегов)
LASTFM_API_KEY=
# Zotify: неинтерактивный импорт ссылок Spotify. Файл credentials не коммитить
ZOTIFY_PATH=
ZOTIFY_CREDENTIALS_PATH=
# Spotify (для импорта плейлистов): Client ID из https://developer.spotify.com/dashboard
# Redirect URI в настройках приложения: http://127.0.0.1:3000/import  (см. README)
SPOTIFY_CLIENT_ID=
# SoundCloud api-v2 client_id. Если пусто, недостающие треки ищутся только через yt-dlp
SOUNDCLOUD_CLIENT_ID=
# Полный путь к yt-dlp, если его нет в PATH (например C:\Tools\yt-dlp.exe)
YTDLP_PATH=
# Папка или файл ffmpeg для конвертации в mp3, если ffmpeg нет в PATH
FFMPEG_PATH=
# Файл cookies Netscape. Если пусто, берётся backend/cookies.txt, затем data/cookies.txt. Файл не коммитить.
# В Docker смонтируйте его в каталог сервиса как /app/cookies.txt
YTDLP_COOKIES_PATH=
# Запасной вариант, если файла нет: chrome, edge, firefox. При открытом браузере часто не читается
YTDLP_COOKIES_FROM_BROWSER=
# Контакт для User-Agent MusicBrainz (их правила требуют контакт)
MUSICBRAINZ_CONTACT=admin@example.com

# --- Прочее ---
# Необязательно: POST-вебхук (Discord/Slack/свой) при новом запросе трека
MAX_UPLOAD_MB=300
# Запускать воркер BullMQ внутри процесса API (для одного контейнера)
RUN_WORKER_IN_PROCESS=true
SCAN_ON_START=false

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum TrackStatus {
  PARSED
  NEEDS_REVIEW
}

enum DownloadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  username      String             @unique
  email         String             @unique
  passwordHash  String             @map("password_hash")
  role          Role               @default(USER)
  canUpload     Boolean            @default(true) @map("can_upload")
  isBlocked     Boolean            @default(false) @map("is_blocked")
  createdAt     DateTime           @default(now()) @map("created_at")
  playlists      Playlist[]
  favorites      UserFavorite[]
  refreshTokens  RefreshToken[]
  tracks         Track[]
  downloads      PlaylistDownload[]
  trackDownloads TrackDownload[]
  plays          Play[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Track {
  id            String          @id @default(uuid()) @db.Uuid
  ownerId       String          @map("owner_id") @db.Uuid
  filePath      String          @unique @map("file_path")
  fileHash      String          @map("file_hash")
  fileSize      BigInt          @map("file_size")
  fileMtimeMs   BigInt          @map("file_mtime_ms")
  title         String
  artist        String
  album         String?
  year          Int?
  duration      Int             @default(0)
  coverImageUrl String?         @map("cover_image_url")
  matchKey      String          @map("match_key")
  status        TrackStatus     @default(PARSED)
  enrichedAt    DateTime?       @map("enriched_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  artistId      String?         @map("artist_id") @db.Uuid
  albumId       String?         @map("album_id") @db.Uuid
  genres        TrackGenre[]
  playlists     PlaylistTrack[]
  favoritedBy   UserFavorite[]
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  artistEntity  Artist?         @relation(fields: [artistId], references: [id], onDelete: SetNull)
  albumEntity   Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  artistLinks   TrackArtist[]

  @@unique([ownerId, fileHash])
  @@index([ownerId, matchKey])
  @@index([matchKey])
  @@index([artist])
  @@index([createdAt])
  @@index([status])
  @@index([artistId])
  @@index([albumId])
  @@map("tracks")
}

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  imageUrl  String?  @map("image_url")
  itunesId  String?  @unique @map("itunes_id")
  createdAt DateTime @default(now()) @map("created_at")
  albums     Album[]
  tracks     Track[]
  trackLinks TrackArtist[]

  @@index([name])
  @@map("artists")
}

model Album {
  id        String   @id @default(uuid()) @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  title     String
  slug      String
  year      Int?
  coverUrl  String?  @map("cover_url")
  itunesId  String?  @unique @map("itunes_id")
  createdAt DateTime @default(now()) @map("created_at")
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks    Track[]

  @@unique([artistId, slug])
  @@index([title])
  @@map("albums")
}

model TrackArtist {
  trackId  String @map("track_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid
  position Int    @default(0)
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([artistId])
  @@map("track_artists")
}

model TrackDownload {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  artist    String
  title     String
  album     String?
  coverUrl  String?        @map("cover_url")
  matchKey  String         @map("match_key")
  status    DownloadStatus @default(PENDING)
  progress  Int?
  error     String?
  trackId   String?        @map("track_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, matchKey])
  @@index([status, createdAt])
  @@map("track_downloads")
}

model Genre {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @unique
  tracks TrackGenre[]

  @@map("genres")
}

model TrackGenre {
  trackId   String  @map("track_id") @db.Uuid
  genreId   String  @map("genre_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  track     Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([genreId])
  @@map("track_genres")
}

model Playlist {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  name        String
  description String?
  isPublic    Boolean            @default(false) @map("is_public")
  coverImage  String?            @map("cover_image")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  downloads   PlaylistDownload[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistDownload {
  id         String         @id @default(uuid()) @db.Uuid
  playlistId String         @map("playlist_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  artist     String
  title      String
  matchKey   String         @map("match_key")
  position   Int
  status     DownloadStatus @default(PENDING)
  progress   Int?
  error      String?
  trackId    String?        @map("track_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  playlist   Playlist       @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([playlistId])
  @@map("playlist_downloads")
}

model PlaylistTrack {
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  position   Int
  addedAt    DateTime @default(now()) @map("added_at")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([playlistId, position])
  @@map("playlist_tracks")
}

model Play {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  artist    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, artist])
  @@index([userId, createdAt])
  @@map("plays")
}

model UserFavorite {
  userId  String   @map("user_id") @db.Uuid
  trackId String   @map("track_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, addedAt])
  @@map("user_favorites")
}